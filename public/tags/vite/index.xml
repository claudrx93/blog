    <item>
      <title>Vite 插件开发入门：打造你自己的构建工具</title>
      <link>http://localhost:1313/posts/2026/05/vite%E6%8F%92%E4%BB%B6%E5%BC%80%E5%8F%91%E5%85%A5%E9%97%A8%E6%89%93%E9%80%A0%E4%BD%A0%E8%87%AA%E5%B7%B1%E7%9A%84%E6%9E%84%E5%BB%BA%E5%B7%A5%E5%85%B7/</link>
